// Prisma schema for SyncPage landing sync
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LandingStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model IntegrationProfile {
  id              String   @id @default(uuid())
  name            String
  webhookUrl      String?
  googleSheetUrl  String?
  googleSheetMeta Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  forms           Form[]
}

model Form {
  id              String           @id @default(uuid())
  title           String
  key             String           @unique
  slug            String           @unique
  body            Json
  
  profileId       String?
  profile         IntegrationProfile? @relation(fields: [profileId], references: [id], onDelete: Restrict)

  webhookUrl      String?
  googleSheetUrl  String?
  googleSheetMeta Json?            // { "startRow": 2, "columns": { "fullName": "A", "email": "B" } }
  
  // تنظیمات OTP
  otpEnabled      Boolean          @default(false)
  otpTemplate     String?          // قالب پیامک (مثلا verify_code)
  otpField        String?          // نام فیلدی که شماره موبایل توش قرار میگیره (مثلا mobile)
  otpLength       Int              @default(5)      // طول کد OTP
  
  // تنظیمات UTM
  sendUtmToWebhook Boolean         @default(true)
  sendUtmToSheet   Boolean         @default(true)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submissions     FormSubmission[]
}

model FormSubmission {
  id         String    @id @default(uuid())
  formId     String
  form       Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  edgeNodeId String?
  edgeNode   EdgeNode? @relation(fields: [edgeNodeId], references: [id], onDelete: SetNull)
  payload    Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // وضعیت احراز هویت پیامکی
  otpStatus          String?   // 'VERIFIED', 'UNVERIFIED', 'NOT_REQUIRED'
  syncVersion        Int       @default(1)
  verifiedAt         DateTime?
  otpChallenge       OtpChallenge?

  webhookStatus      OutboxStatus @default(SENT)
  webhookAttempts    Int          @default(0)
  webhookLastError   String?
  webhookInvocations WebhookInvocation[]

  @@index([formId])
  @@index([edgeNodeId])
}

model WebhookInvocation {
  id             String         @id @default(uuid())
  submissionId   String
  submission     FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attempt        Int
  requestUrl     String
  success        Boolean
  responseStatus Int?
  responseBody   String?
  responseHeaders Json?
  error          String?
  durationMs     Int?
  createdAt      DateTime       @default(now())

  @@index([createdAt])
  @@index([submissionId, createdAt])
}

model OtpChallenge {
  id           String         @id @default(uuid())
  submissionId String         @unique
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mobile       String
  codeHash     String
  expiresAt    DateTime
  verifiedAt   DateTime?
  attempts     Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([expiresAt])
}

// برای نگهداری تنظیمات سراسری مانند API Key کاوه‌نگار
model SystemSetting {
  key   String @id
  value String
}

model Landing {
  id        String        @id @default(uuid())
  slug      String        @unique
  version   Int           @default(1)
  checksum  String
  status    LandingStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model OutboxEvent {
  id             String       @id @default(uuid())
  eventType      String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  idempotencyKey String       @unique
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
}

model ProcessedEvent {
  idempotencyKey String   @id
  processedAt    DateTime @default(now())
}

enum EdgeNodeStatus {
  PENDING
  ONLINE
  OFFLINE
  ERROR
}

enum SyncOperationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum SyncNodeStatus {
  QUEUED
  DEPLOYING
  COMPLETED
  FAILED
  UNREACHABLE
}

model SyncOperation {
  id           String              @id @default(uuid())
  landingSlugs Json
  status       SyncOperationStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  nodes        SyncOperationNode[]
}

model SyncOperationNode {
  id          String         @id @default(uuid())
  operationId String
  nodeId      String
  status      SyncNodeStatus @default(QUEUED)
  lastError   String?
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt
  operation   SyncOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  node        EdgeNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([operationId, nodeId])
  @@index([operationId])
}

// نودهای Edge که از پنل مدیریت ثبت می‌شن
model EdgeNode {
  id              String         @id @default(uuid())
  title           String
  host            String
  port            Int            @default(3000)
  queueName       String         @unique
  installToken    String         @unique
  status          EdgeNodeStatus @default(PENDING)
  lastSeenAt      DateTime?
  lastError       String?
  rabbitStatus    EdgeNodeStatus @default(PENDING)
  rabbitLastError String?
  notes           String?
  submissions     FormSubmission[]
  syncOperations  SyncOperationNode[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}
