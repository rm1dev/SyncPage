NODE_ROLE=MASTER
PORT=3000
NODE_ENV=development

POSTGRES_USER=syncpage
POSTGRES_PASSWORD=syncpage
POSTGRES_DB=syncpage
# لوکال: localhost | داخل Docker Compose Master: مقدارش توسط compose با هاست db override می‌شه
DATABASE_URL=postgresql://syncpage:syncpage@localhost:5432/syncpage?schema=public

# این دو تا باید یکی باشن؛ entrypoint همون پسورد رو توی RabbitMQ ست می‌کنه
# ترجیحاً فقط حروف/عدد (کاراکترهای خاص URL رو خراب می‌کنن)
RABBITMQ_USER=syncpage
RABBITMQ_PASS=syncpage
RABBITMQ_URL=amqp://syncpage:syncpage@localhost:5672
# آدرس RabbitMQ که نودهای Edge از بیرون بهش وصل می‌شن (همون پسورد)
# اگر به :5672 از خارج ETIMEDOUT خوردی، از پورت جایگزین استفاده کن (compose روی 45672 هم publish می‌کنه):
# RABBITMQ_PUBLIC_URL=amqp://syncpage:PASS@MASTER_IP:45672
RABBITMQ_PUBLIC_URL=amqp://syncpage:syncpage@localhost:5672
# پورت host برای publish جایگزین (پیش‌فرض 45672)
# RABBITMQ_PUBLIC_PORT=45672
RABBITMQ_QUEUE=landing.sync
RABBITMQ_MASTER_QUEUE=form.submission

ADMIN_TOKEN=change-me-admin-token

STATIC_PAGES_PATH=./static_pages
TEMP_PATH=./temp

# آدرس داخلی Master برای دانلود ZIP توسط Edge
MASTER_INTERNAL_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost

OUTBOX_POLL_MS=3000
OUTBOX_MAX_ATTEMPTS=10

# فقط روی Edge: شناسه نود ثبت‌شده در پنل
# EDGE_NODE_ID=

# Edge ریموت (جدا از Master): host — از Docker bridge به :5672 timeout می‌خوره
# Edge هم‌محل با Master: bridge + RABBITMQ_URL با host.docker.internal
# EDGE_NETWORK_MODE=host
# POSTGRES_HOST_PORT=5433
# COMPOSE_FILE=docker-compose.node.remote.yml

# ریپوی گیت‌هاب (برای کامند نصب در پنل)
SYNCPAGE_GITHUB_REPO=rm1dev/SyncPage
SYNCPAGE_GITHUB_BRANCH=main
