<header class="page-header">
  <div class="page-header-title">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle Sidebar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1>پرداخت‌ها</h1>
    </div>
    <span class="subtitle">مشاهده سوابق و وضعیت تراکنش‌های درگاه پرداخت پی‌پینگ</span>
  </div>
</header>

{{!-- آمارهای خلاصه تراکنش‌ها --}}
<div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
  <div class="content-wrapper" style="margin-bottom: 0; padding: 1.25rem;">
    <span style="font-size: 0.85rem; color: var(--text-muted); display: block; margin-bottom: 0.5rem;">کل تراکنش‌ها</span>
    <strong style="font-size: 1.6rem; color: var(--text-main);">{{stats.totalCount}}</strong>
  </div>
  <div class="content-wrapper" style="margin-bottom: 0; padding: 1.25rem; border-right: 3px solid #10b981;">
    <span style="font-size: 0.85rem; color: var(--text-muted); display: block; margin-bottom: 0.5rem;">پرداخت‌های موفق</span>
    <strong style="font-size: 1.6rem; color: #10b981;">{{stats.completedCount}}</strong>
    <span style="font-size: 0.8rem; color: var(--text-muted); display: block; margin-top: 0.25rem;">(جمع: {{stats.formattedTotalAmount}} تومان)</span>
  </div>
  <div class="content-wrapper" style="margin-bottom: 0; padding: 1.25rem; border-right: 3px solid #f59e0b;">
    <span style="font-size: 0.85rem; color: var(--text-muted); display: block; margin-bottom: 0.5rem;">در انتظار پرداخت</span>
    <strong style="font-size: 1.6rem; color: #f59e0b;">{{stats.pendingCount}}</strong>
  </div>
  <div class="content-wrapper" style="margin-bottom: 0; padding: 1.25rem; border-right: 3px solid #ef4444;">
    <span style="font-size: 0.85rem; color: var(--text-muted); display: block; margin-bottom: 0.5rem;">ناموفق / ریورس</span>
    <strong style="font-size: 1.6rem; color: #ef4444;">{{stats.failedCount}}</strong>
  </div>
</div>

{{!-- فیلترها --}}
<div class="content-wrapper" style="margin-bottom: 2rem;">
  <form method="GET" action="/spadmin/payments" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">
    <div class="form-group" style="flex: 1; min-width: 200px; margin-bottom: 0;">
      <label for="formId">فرم مربوطه:</label>
      <select name="formId" id="formId" class="form-control">
        <option value="">همه فرم‌ها</option>
        {{#each forms}}
          <option value="{{id}}" {{#if (eq id ../formId)}}selected{{/if}}>{{title}} ({{key}})</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group" style="flex: 1; min-width: 180px; margin-bottom: 0;">
      <label for="productId">محصول:</label>
      <select name="productId" id="productId" class="form-control">
        <option value="">همه محصولات</option>
        {{#each products}}
          <option value="{{id}}" {{#if (eq id ../productId)}}selected{{/if}}>{{title}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 0;">
      <label for="status">وضعیت پرداخت:</label>
      <select name="status" id="status" class="form-control">
        <option value="">همه وضعیت‌ها</option>
        <option value="COMPLETED" {{#if (eq status 'COMPLETED')}}selected{{/if}}>موفق (Completed)</option>
        <option value="PENDING" {{#if (eq status 'PENDING')}}selected{{/if}}>در انتظار (Pending)</option>
        <option value="FAILED" {{#if (eq status 'FAILED')}}selected{{/if}}>ناموفق (Failed)</option>
        <option value="REVERSED" {{#if (eq status 'REVERSED')}}selected{{/if}}>برگشت خورده (Reversed)</option>
      </select>
    </div>

    <div class="form-group" style="flex: 1; min-width: 130px; margin-bottom: 0;">
      <label for="startDate">از تاریخ:</label>
      <input type="text" name="startDate" id="startDate" placeholder="1403/01/01" value="{{startDate}}" class="form-control" />
    </div>

    <div class="form-group" style="flex: 1; min-width: 130px; margin-bottom: 0;">
      <label for="endDate">تا تاریخ:</label>
      <input type="text" name="endDate" id="endDate" placeholder="1403/12/29" value="{{endDate}}" class="form-control" />
    </div>

    <div style="display: flex; gap: 0.5rem;">
      <button type="submit" class="btn btn-primary" style="height: 38px;">
        <span>فیلتر و گزارش</span>
      </button>
      <button type="submit" formaction="/spadmin/payments/export/excel" class="btn btn-secondary" style="height: 38px; display: inline-flex; align-items: center; gap: 0.4rem; background: #059669; border-color: #059669; color: white;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>خروجی اکسل</span>
      </button>
    </div>
  </form>
</div>

{{!-- جدول تراکنش‌ها --}}
<div class="content-wrapper">
  <div class="section-header">
    <span>لیست پرداخت‌ها</span>
    <span class="status-pill">{{payments.length}} تراکنش</span>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>فرم</th>
          <th>محصول</th>
          <th>مبلغ (تومان)</th>
          <th>وضعیت</th>
          <th>کد پیگیری درگاه (RefID)</th>
          <th>شماره کارت</th>
          <th>نود مبدا</th>
          <th>تاریخ ثبت / تایید</th>
          <th>اطلاعات لید</th>
        </tr>
      </thead>
      <tbody>
        {{#each payments}}
        <tr>
          <td style="font-weight: 600;">
            {{formTitle}}
            <div style="font-size: 0.75rem; color: var(--text-muted);">/{{formSlug}}</div>
          </td>
          <td>
            <strong>{{productTitle}}</strong>
          </td>
          <td style="white-space: nowrap;">
            <strong style="color: var(--accent-primary); font-size: 1rem;">{{formattedAmount}}</strong>
            <span style="font-size: 0.8rem; color: var(--text-muted); margin-right: 0.2rem;">تومان</span>
          </td>
          <td>
            {{#if isCompleted}}
              <span class="status-pill status-ok" style="font-size: 0.8rem; background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">موفق</span>
            {{else if isPending}}
              <span class="status-pill" style="font-size: 0.8rem; background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3);">در انتظار</span>
            {{else if isReversed}}
              <span class="status-pill status-err" style="font-size: 0.8rem; background: rgba(249, 115, 22, 0.15); color: #f97316; border: 1px solid rgba(249, 115, 22, 0.3);">ریورس شده</span>
            {{else}}
              <span class="status-pill status-err" style="font-size: 0.8rem; background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3);">ناموفق</span>
            {{/if}}
          </td>
          <td style="white-space: nowrap;">
            {{#if refId}}
              <code style="font-family: monospace; font-size: 0.9rem; font-weight: 600;">{{refId}}</code>
            {{else}}
              <span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
            {{/if}}
          </td>
          <td style="white-space: nowrap;">
            {{#if cardNumber}}
              <span style="direction: ltr; display: inline-block; font-family: monospace; font-size: 0.85rem;">{{cardNumber}}</span>
            {{else}}
              <span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
            {{/if}}
          </td>
          <td>
            <span class="status-pill" style="background: rgba(255,255,255,0.06); color: var(--text-main); font-size: 0.8rem;">{{nodeTitle}}</span>
          </td>
          <td style="white-space: nowrap; font-size: 0.85rem;">
            <div>{{createdAtFa}}</div>
            {{#if verifiedAtFa}}
              <div style="font-size: 0.75rem; color: #10b981; margin-top: 0.2rem;">تایید: {{verifiedAtFa}}</div>
            {{/if}}
          </td>
          <td>
            {{#if submissionPayload}}
              <details style="cursor: pointer;">
                <summary style="font-size: 0.8rem; color: var(--accent-primary);">مشاهده داده‌ها</summary>
                <pre style="margin-top: 0.5rem; padding: 0.5rem; background: rgba(0,0,0,0.2); border-radius: 4px; font-size: 0.8rem; max-width: 320px; overflow-x: auto;">{{submissionPayload}}</pre>
              </details>
            {{else}}
              <span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
            {{/if}}
            {{#if errorMessage}}
              <div style="color: #ef4444; font-size: 0.75rem; margin-top: 0.25rem;">خطا: {{errorMessage}}</div>
            {{/if}}
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="9" style="text-align: center; color: var(--text-muted); padding: 2rem;">
            هیچ پرداختی با شرایط انتخابی ثبت نشده است.
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
