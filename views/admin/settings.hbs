<header class="page-header">
  <div class="page-header-title">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle Sidebar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1>تنظیمات سیستم</h1>
    </div>
    <span class="subtitle">پیکربندی وب‌سرویس‌ها و پنل‌های پیامکی</span>
  </div>
</header>

{{#if flash}}
  <div class="alert alert-ok">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    <span>{{flash}}</span>
  </div>
{{/if}}

<div class="content-wrapper">
  <div class="section-header">
    <span>تنظیمات سامانه پیامکی کاوه‌نگار</span>
  </div>
  
  <form method="POST" action="/spadmin/settings/kavenegar" style="max-width: 600px;">
    <div class="form-group text-left">
      <label class="form-label" for="apiKey">کلید وب‌سرویس (API-KEY)</label>
      <input type="password" class="form-control" id="apiKey" name="apiKey" placeholder="مثلاً: 3543... یا مقدار کپی شده از پنل کاوه‌نگار" value="{{kavenegarApiKey}}" required />
      <small style="color: var(--text-muted);">
        جهت ارسال پیامک‌های اعتبارسنجی (OTP Lookup) نیاز به وارد کردن API Key از پنل کاوه‌نگار دارید.
      </small>
    </div>

    <button type="submit" class="btn btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      <span>ذخیره تنظیمات</span>
    </button>
  </form>
</div>
