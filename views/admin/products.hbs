<header class="page-header">
  <div class="page-header-title">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle Sidebar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1>مدیریت محصولات</h1>
    </div>
    <span class="subtitle">تعریف محصولات و تعیین قیمت به تومان برای پرداخت در فرم‌ها</span>
  </div>
  <button type="button" class="btn btn-primary" id="btn-toggle-product-form">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    <span>افزودن محصول جدید</span>
  </button>
</header>

{{#if flash}}
  <div class="alert alert-ok">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    <span>{{flash}}</span>
  </div>
{{/if}}
{{#if error}}
  <div class="alert alert-error">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>{{error}}</span>
  </div>
{{/if}}

{{!-- بخش فرم ایجاد یا ویرایش محصول --}}
<div id="product-form-card" class="content-wrapper" style="{{#if showForm}}display: block;{{else}}display: none;{{/if}} margin-bottom: 2rem;">
  <div class="section-header">
    <span>{{#if editProduct}}ویرایش محصول: {{editProduct.title}}{{else}}تعریف محصول جدید{{/if}}</span>
    <a href="/spadmin/products" class="btn btn-subtle btn-sm">بستن فرم</a>
  </div>

  <form method="POST" action="{{#if editProduct}}/spadmin/products/{{editProduct.id}}{{else}}/spadmin/products{{/if}}" style="max-width: 700px;">
    <div class="grid-2">
      <div class="form-group text-left">
        <label class="form-label" for="productTitle">عنوان محصول</label>
        <input class="form-control" id="productTitle" name="title" placeholder="مثلاً: پکیج طلایی یا ثبت‌نام دوره" value="{{editProduct.title}}" required autofocus />
      </div>

      <div class="form-group text-left">
        <label class="form-label" for="productPrice">قیمت (تومان)</label>
        <input type="number" class="form-control" id="productPrice" name="price" value="{{editProduct.price}}" required />
        <small style="color: var(--text-muted); font-size: 0.8rem;">مبلغ به صورت دقیق به درگاه ارسال می‌شود.</small>
      </div>
    </div>

    <div class="form-group text-left">
      <label class="form-label" for="productDescription">توضیحات (اختیاری)</label>
      <textarea class="form-control" id="productDescription" name="description" rows="3" placeholder="توضیحات تکمیلی محصول یا خدمات...">{{editProduct.description}}</textarea>
    </div>

    <div style="display: flex; gap: 0.75rem;">
      <button type="submit" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        <span>{{#if editProduct}}ذخیره تغییرات{{else}}ثبت محصول{{/if}}</span>
      </button>
      <a href="/spadmin/products" class="btn btn-secondary">انصراف</a>
    </div>
  </form>
</div>

<div class="content-wrapper">
  <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
    <div>
      <span>لیست محصولات</span>
      <span class="status-pill">{{products.length}} محصول</span>
    </div>
    <form method="GET" action="/spadmin/products" style="display: flex; gap: 0.5rem; align-items: center;">
      <input class="form-control" type="search" name="q" value="{{q}}" placeholder="جستجو در عنوان یا توضیحات..." style="min-width: 250px;" />
      <button type="submit" class="btn btn-secondary">جستجو</button>
      {{#if q}}<a href="/spadmin/products" class="btn btn-subtle">پاک کردن</a>{{/if}}
    </form>
  </div>

  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>عنوان محصول</th>
          <th>قیمت (تومان)</th>
          <th>توضیحات</th>
          <th>فرم‌های متصل</th>
          <th>پرداخت‌ها</th>
          <th>تاریخ ثبت (جلالی)</th>
          <th class="actions">عملیات</th>
        </tr>
      </thead>
      <tbody>
        {{#each products}}
        <tr>
          <td style="font-weight: 600;">
            {{title}}
            <div style="font-size: 0.75rem; color: var(--text-muted); font-family: monospace;">شناسه: {{id}}</div>
          </td>
          <td style="white-space: nowrap;">
            <strong style="color: var(--accent-primary); font-size: 1.05rem;">{{formattedPrice}}</strong>
            <span style="font-size: 0.8rem; color: var(--text-muted); margin-right: 0.25rem;">تومان</span>
          </td>
          <td style="font-size: 0.85rem; max-width: 250px;">
            {{#if description}}{{description}}{{else}}<span style="color: var(--text-muted);">—</span>{{/if}}
          </td>
          <td>
            <span class="status-pill">{{_count.formProducts}} فرم</span>
          </td>
          <td>
            <a href="/spadmin/payments?productId={{id}}" class="btn-subtle">{{_count.payments}} پرداخت</a>
          </td>
          <td style="white-space: nowrap; font-size: 0.85rem;">{{jalaliDate}}</td>
          <td class="actions">
            <a href="/spadmin/products?edit={{id}}{{#if ../q}}&q={{../q}}{{/if}}" class="btn-subtle">ویرایش</a>
            <form method="POST" action="/spadmin/products/{{id}}/delete" style="display: inline; margin-right: 0.5rem;" onsubmit="return confirm('آیا از حذف محصول «{{title}}» اطمینان دارید؟');">
              <button type="submit" class="btn-subtle" style="color: var(--color-danger, #f43f5e);">حذف</button>
            </form>
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">
            هیچ محصولی یافت نشد. برای شروع دکمه «افزودن محصول جدید» را بزنید.
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toggleBtn = document.getElementById('btn-toggle-product-form');
    const formCard = document.getElementById('product-form-card');
    if (toggleBtn && formCard) {
      toggleBtn.addEventListener('click', function () {
        if (formCard.style.display === 'none' || formCard.style.display === '') {
          formCard.style.display = 'block';
          formCard.scrollIntoView({ behavior: 'smooth' });
          const titleInput = document.getElementById('productTitle');
          if (titleInput) titleInput.focus();
        } else {
          formCard.style.display = 'none';
        }
      });
    }
  });
</script>
