<header class="page-header">
  <div class="page-header-title">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle Sidebar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1>خطاهای ارسال وب‌هوک</h1>
    </div>
    <span class="subtitle">لیدهایی که ارسال وب‌هوک آن‌ها با خطا مواجه شده است</span>
  </div>
</header>

{{#if flash}}
  <div class="alert alert-ok">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    <span>{{flash}}</span>
  </div>
{{/if}}
{{#if error}}
  <div class="alert alert-error">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>{{error}}</span>
  </div>
{{/if}}

<div class="content-wrapper">
  <div class="section-header">
    <span>لیست خطاهای ارسال</span>
    <span class="status-pill">{{items.length}} مورد</span>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>نام فرم</th>
          <th>تاریخ ثبت (جلالی)</th>
          <th>تعداد تلاش</th>
          <th>خطا / جزئیات لید</th>
          <th class="actions">عملیات</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td style="font-weight: 600;">{{formTitle}}</td>
          <td style="white-space: nowrap;">{{jalaliDate}}</td>
          <td><span class="status-pill" style="background: rgba(239, 68, 68, 0.2); color: #f87171;">{{attempts}} بار</span></td>
          <td>
            <div style="font-size: 0.85rem; color: #ef4444; margin-bottom: 0.5rem; max-width: 400px; word-wrap: break-word;">{{lastError}}</div>
            <pre style="margin: 0; padding: 0.5rem; background: rgba(0,0,0,0.2); border-radius: 4px; font-size: 0.8rem; max-width: 400px; overflow-x: auto;">{{payloadStr}}</pre>
          </td>
          <td class="actions">
            <form method="POST" action="/spadmin/failed-webhooks/{{id}}/retry">
              <button type="submit" class="btn btn-primary" style="height: 32px; padding: 0 1rem; font-size: 0.85rem;" onclick="return confirm('آیا می‌خواهید درخواست دوباره ارسال شود؟')">تلاش مجدد</button>
            </form>
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">
            موردی یافت نشد. همه لیدها با موفقیت ارسال شده‌اند.
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
