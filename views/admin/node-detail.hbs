<header class="page-header">
  <div class="page-header-title">
    <h1>{{node.title}}</h1>
    <span class="subtitle">نصب، تایید اتصال HTTP و صف Rabbit، تنظیمات نود Edge</span>
  </div>
  <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
    <form method="post" action="/spadmin/nodes/{{node.id}}/verify">
      <button type="submit" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>تایید اتصال</span>
      </button>
    </form>
    <a href="/spadmin/nodes" class="btn btn-secondary"><span>بازگشت</span></a>
  </div>
</header>

{{#if flash}}
  <div class="alert alert-ok">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    <span>{{flash}}</span>
  </div>
{{/if}}
{{#if error}}
  <div class="alert alert-error">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>{{error}}</span>
  </div>
{{/if}}

{{#if node.versionOutdated}}
  <div class="alert alert-error" style="flex-direction:column; align-items:stretch; gap:0.75rem;">
    <div>
      <strong>این نود نسخه قدیمی دارد</strong>
      — فعلی <code>{{node.localVersion}}</code>
      {{#if node.latestVersion}}، GitHub <code>{{node.latestVersion}}</code>{{/if}}
    </div>
    <div class="install-cmd-box">
      <code id="node-update-cmd">{{node.updateCommand}}</code>
      <button type="button" class="btn btn-secondary btn-copy" data-copy="#node-update-cmd">کپی</button>
    </div>
    <p style="margin:0; font-size:0.85rem; color:var(--text-muted);">روی سرور همین نود با root اجرا کنید. <code>.env</code> حفظ می‌شود.</p>
  </div>
{{/if}}

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">وضعیت HTTP</span>
      <span class="stat-value" style="font-size:1.1rem;"><span class="status-pill status-{{node.statusClass}}">{{node.statusLabel}}</span></span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">صف / Rabbit</span>
      <span class="stat-value" style="font-size:1.1rem;"><span class="status-pill status-{{node.rabbitStatusClass}}">{{node.rabbitStatusLabel}}</span></span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">آدرس</span>
      <span class="stat-value" style="font-size:1rem;"><code>{{node.host}}:{{node.port}}</code></span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">نسخه</span>
      <span class="stat-value" style="font-size:1rem;">
        {{#if node.localVersion}}<code>v{{node.localVersion}}</code>{{else}}{{#if node.versionUnreachable}}در دسترس نیست{{else}}—{{/if}}{{/if}}
      </span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">آخرین بازدید</span>
      <span class="stat-value" style="font-size:1rem;">{{node.lastSeenLabel}}</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">نام صف</span>
      <span class="stat-value" style="font-size:0.9rem;"><code>{{node.queueName}}</code></span>
    </div>
  </div>
</div>

{{#if node.rabbitLastError}}
  <div class="alert alert-error" style="margin-top:1rem;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>خطای صف Rabbit: {{node.rabbitLastError}}</span>
  </div>
{{/if}}
{{#if node.lastError}}
  <div class="alert alert-error" style="margin-top:0.75rem;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>آخرین خطای تایید: {{node.lastError}}</span>
  </div>
{{/if}}

<div class="content-wrapper mt-3" id="live-active-download" {{#unless stats.activeDownload}}style="display: none;"{{/unless}}>
  <div class="section-header">
    <span>در حال دانلود</span>
    <span class="status-pill status-warn">زنده</span>
  </div>
  <div style="background: var(--surface-hover); padding: 1rem; border-radius: 6px; border: 1px solid var(--border-color);" id="active-download-inner">
    {{#if stats.activeDownload}}
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
        <strong style="font-size: 1.1rem;">{{stats.activeDownload.slug}} <span style="color: var(--text-muted); font-size: 0.9rem; font-weight: normal;">(نسخه {{stats.activeDownload.version}})</span></strong>
        <span style="font-family: monospace; background: var(--color-primary-bg); color: var(--color-primary); padding: 0.1rem 0.5rem; border-radius: 4px; font-weight: 600;">
          {{stats.activeDownload.currentSpeed}}
        </span>
      </div>
      
      <div style="width: 100%; height: 8px; background: rgba(0,0,0,0.1); border-radius: 4px; overflow: hidden; margin-bottom: 0.5rem;">
        <div style="height: 100%; width: {{stats.activeDownload.progress}}%; background: var(--color-primary); transition: width 1s linear;"></div>
      </div>
      
      <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--text-muted);">
        <span>{{stats.activeDownload.progress}}% کامل شده</span>
        {{#if stats.activeDownload.etaSeconds}}
          <span>زمان باقیمانده: حدود {{stats.activeDownload.etaSeconds}} ثانیه</span>
        {{else}}
          <span>در حال محاسبه...</span>
        {{/if}}
      </div>
      
      {{#if stats.activeDownload.retries}}
        <div style="margin-top: 0.5rem; font-size: 0.8rem; color: var(--color-warning);">
          تعداد تلاش مجدد (Resume): {{stats.activeDownload.retries}} بار
        </div>
      {{/if}}
    {{/if}}
  </div>
</div>

{{#if stats.downloadHistory.length}}
  <div class="content-wrapper mt-3" id="live-download-history">
    <div class="section-header">
      <span>تاریخچه دانلودهای اخیر</span>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>لندینگ</th>
            <th>مدت زمان</th>
            <th>سرعت میانگین</th>
            <th>وضعیت</th>
            <th>زمان انجام</th>
          </tr>
        </thead>
        <tbody>
          {{#each stats.downloadHistory}}
          <tr>
            <td style="font-weight: 600;">{{slug}}</td>
            <td>{{durationSec}} ثانیه</td>
            <td style="font-family: monospace;">{{avgSpeed}}</td>
            <td>
              {{#if (eq status 'SUCCESS')}}
                <span class="status-pill status-ok">موفق</span>
              {{else}}
                <span class="status-pill status-err" title="{{error}}">خطا</span>
              {{/if}}
            </td>
            <td dir="ltr" style="text-align: right; font-size: 0.85rem; color: var(--text-muted);">{{timestamp}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
{{/if}}

<!-- کامند نصب silent -->
<div class="content-wrapper">
  <div class="section-header">
    <span>کامند نصب نود (بدون سوال)</span>
  </div>
  <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
    این کامند را روی سرور Edge با دسترسی root اجرا کنید. همه تنظیمات از Master گرفته می‌شود و هیچ سوالی پرسیده نمی‌شود.
  </p>
  <div class="install-cmd-box">
    <code id="install-cmd">{{node.installCommand}}</code>
    <button type="button" class="btn btn-secondary btn-copy" data-copy="#install-cmd">کپی</button>
  </div>

  <div class="section-header" style="margin-top:1.5rem;">
    <span>کامند آپدیت نود</span>
  </div>
  <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
    برای به‌روز کردن کد بدون نصب مجدد و بدون از دست رفتن تنظیمات.
  </p>
  <div class="install-cmd-box">
    <code id="update-cmd">{{node.updateCommand}}</code>
    <button type="button" class="btn btn-secondary btn-copy" data-copy="#update-cmd">کپی</button>
  </div>

  <div class="section-header" style="margin-top:1.5rem;">
    <span>کامند حذف کامل نود از سرور</span>
  </div>
  <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
    روی سرور Edge با root اجرا کنید: کانتینرها، volumeها و پوشه <code>/opt/syncpage-node</code> پاک می‌شوند.
    بعد از آن از بخش پایین، نود را از پنل Master هم حذف کنید.
  </p>
  <div class="install-cmd-box">
    <code id="uninstall-cmd">{{node.uninstallCommand}}</code>
    <button type="button" class="btn btn-secondary btn-copy" data-copy="#uninstall-cmd">کپی</button>
  </div>
  {{#if node.lastError}}
    <p style="color: var(--color-danger); margin-top: 0.75rem; font-size: 0.85rem;">آخرین خطا: {{node.lastError}}</p>
  {{/if}}
  <div style="margin-top: 1rem; display:flex; gap:0.5rem; flex-wrap:wrap;">
    <form method="post" action="/spadmin/nodes/{{node.id}}/regenerate-token">
      <button type="submit" class="btn btn-secondary" onclick="return confirm('توکن قبلی باطل می‌شود. ادامه؟')">
        <span>ساخت توکن نصب جدید</span>
      </button>
    </form>
    
    <form method="post" action="/spadmin/nodes/{{node.id}}/sync-landings">
      <button type="submit" class="btn btn-primary" onclick="return confirm('آیا می‌خواهید همه لندینگ‌های فعال موجود در سیستم را به این نود پوش کنید؟')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <span>پوش تمام لندینگ‌ها به این نود</span>
      </button>
    </form>
  </div>
</div>

<div class="content-wrapper mt-3">
  <div class="section-header"><span>وضعیت لندینگ‌ها روی این نود</span></div>
  {{#if landingStatus.length}}
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>لندینگ</th>
            <th>نسخه مستر</th>
            <th>نسخه نود</th>
            <th>وضعیت</th>
          </tr>
        </thead>
        <tbody id="live-landing-status">
          {{#each landingStatus}}
          <tr>
            <td style="font-weight: 600;">{{slug}}</td>
            <td>v{{masterVersion}}</td>
            <td>
              {{#if (eq edgeVersion "ندارد")}}
                <span style="color: var(--color-danger);">{{edgeVersion}}</span>
              {{else}}
                v{{edgeVersion}}
              {{/if}}
            </td>
            <td>
              {{#if isSynced}}
                <span class="status-pill status-ok">سینک شده</span>
              {{else}}
                <span class="status-pill status-err">نیازمند سینک</span>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <p style="color: var(--text-muted); text-align: center; margin: 1rem 0;">هیچ لندینگی در سیستم وجود ندارد.</p>
  {{/if}}
</div>

<script>
  // به‌روزرسانی لایو وضعیت دانلودها و لندینگ‌ها برای نود زنده
  function pollNodeStatus() {
    fetch(`/spadmin/api/nodes/{{node.id}}/live-status`)
      .then(res => res.json())
      .then(data => {
        if (!data.ok) return;

        // بروزرسانی لندینگ‌ها
        if (data.landingStatus && data.landingStatus.length) {
          const tbody = document.getElementById('live-landing-status');
          if (tbody) {
            let html = '';
            data.landingStatus.forEach(ls => {
              const edgeVerHtml = ls.edgeVersion === null 
                ? `<span style="color: var(--color-danger);">ندارد</span>` 
                : `v${ls.edgeVersion}`;
              
              const statusHtml = ls.isSynced
                ? `<span class="status-pill status-ok">سینک شده</span>`
                : `<span class="status-pill status-err">نیازمند سینک</span>`;
                
              html += `<tr>
                <td style="font-weight: 600;">${ls.slug}</td>
                <td>v${ls.masterVersion}</td>
                <td>${edgeVerHtml}</td>
                <td>${statusHtml}</td>
              </tr>`;
            });
            tbody.innerHTML = html;
          }
        }

        // بروزرسانی دانلود فعال
        const activeContainer = document.getElementById('live-active-download');
        if (data.stats.activeDownload) {
          const ad = data.stats.activeDownload;
          const html = `
            <div class="section-header">
              <span>در حال دانلود</span>
              <span class="status-pill status-warn">زنده</span>
            </div>
            <div style="background: var(--surface-hover); padding: 1rem; border-radius: 6px; border: 1px solid var(--border-color);">
              <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
                <strong style="font-size: 1.1rem;">${ad.slug} <span style="color: var(--text-muted); font-size: 0.9rem; font-weight: normal;">(نسخه ${ad.version})</span></strong>
                <span style="font-family: monospace; background: var(--color-primary-bg); color: var(--color-primary); padding: 0.1rem 0.5rem; border-radius: 4px; font-weight: 600;">
                  ${ad.currentSpeed}
                </span>
              </div>
              
              <div style="width: 100%; height: 8px; background: rgba(0,0,0,0.1); border-radius: 4px; overflow: hidden; margin-bottom: 0.5rem;">
                <div style="height: 100%; width: ${ad.progress}%; background: var(--color-primary); transition: width 1s linear;"></div>
              </div>
              
              <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--text-muted);">
                <span>${ad.progress}% کامل شده</span>
                <span>${ad.etaSeconds ? 'زمان باقیمانده: حدود ' + ad.etaSeconds + ' ثانیه' : 'در حال محاسبه...'}</span>
              </div>
              
              ${ad.retries ? `<div style="margin-top: 0.5rem; font-size: 0.8rem; color: var(--color-warning);">تعداد تلاش مجدد (Resume): ${ad.retries} بار</div>` : ''}
            </div>`;
          
          if (activeContainer) {
            // Check if we are transitioning from not downloading to downloading
            const wasHidden = activeContainer.style.display === 'none';
            activeContainer.innerHTML = html;
            activeContainer.style.display = 'block';
            if (wasHidden) activeContainer.dataset.wasDownloading = "true";
          } else {
            location.reload();
          }
        } else if (activeContainer) {
          // Check if we were downloading and now finished
          if (activeContainer.style.display !== 'none' || activeContainer.dataset.wasDownloading === "true") {
             activeContainer.style.display = 'none';
             activeContainer.dataset.wasDownloading = "false";
             location.reload(); // Refresh to update history and landing status tables
          }
        }
      })
      .catch(err => console.error('Live status error:', err));
  }
  
  // هر ۳ ثانیه یکبار اطلاعات رو بگیر
  setInterval(pollNodeStatus, 3000);
</script>

<div class="content-wrapper mt-3">
  <div class="section-header"><span>ویرایش مشخصات</span></div>
  <form method="post" action="/spadmin/nodes/{{node.id}}">
    <div class="form-group">
      <label class="form-label" for="title">عنوان</label>
      <input class="form-control" id="title" name="title" required value="{{node.title}}" />
    </div>
    <div class="form-group">
      <label class="form-label" for="host">IP / Hostname</label>
      <input class="form-control" id="host" name="host" required value="{{node.host}}" />
    </div>
    <div class="form-group">
      <label class="form-label" for="port">پورت</label>
      <input class="form-control" id="port" name="port" type="number" min="1" max="65535" value="{{node.port}}" />
    </div>
    <div class="form-group">
      <label class="form-label" for="notes">یادداشت</label>
      <textarea class="form-control" id="notes" name="notes" rows="3">{{node.notes}}</textarea>
    </div>
    <div class="form-group">
      <label class="form-label">صف RabbitMQ</label>
      <input class="form-control" value="{{node.queueName}}" readonly />
    </div>
    <div class="form-group">
      <label class="form-label">شناسه نود</label>
      <input class="form-control" value="{{node.id}}" readonly />
    </div>
    <button type="submit" class="btn btn-primary"><span>ذخیره تغییرات</span></button>
  </form>
</div>

<div class="content-wrapper mt-3">
  <div class="section-header"><span>حذف نود از پنل</span></div>
  <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
    فقط رکورد و صف را از Master پاک می‌کند. برای پاک کردن فایل‌ها از سرور Edge، اول کامند حذف کامل بالا را اجرا کنید.
  </p>
  <form method="post" action="/spadmin/nodes/{{node.id}}/delete" onsubmit="return confirm('نود برای همیشه از پنل حذف شود؟')">
    <button type="submit" class="btn" style="background: var(--color-danger-bg); color: var(--color-danger);">
      <span>حذف از پنل Master</span>
    </button>
  </form>
</div>
