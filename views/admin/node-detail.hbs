<header class="page-header">
  <div class="page-header-title">
    <h1>{{node.title}}</h1>
    <span class="subtitle">نصب، تایید اتصال HTTP و صف Rabbit، تنظیمات نود Edge</span>
  </div>
  <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
    <form method="post" action="/spadmin/nodes/{{node.id}}/verify">
      <button type="submit" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>تایید اتصال</span>
      </button>
    </form>
    <a href="/spadmin/nodes" class="btn btn-secondary"><span>بازگشت</span></a>
  </div>
</header>

{{#if flash}}
  <div class="alert alert-ok">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    <span>{{flash}}</span>
  </div>
{{/if}}
{{#if error}}
  <div class="alert alert-error">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>{{error}}</span>
  </div>
{{/if}}

{{#if node.versionOutdated}}
  <div class="alert alert-error" style="flex-direction:column; align-items:stretch; gap:0.75rem;">
    <div>
      <strong>این نود نسخه قدیمی دارد</strong>
      — فعلی <code>{{node.localVersion}}</code>
      {{#if node.latestVersion}}، GitHub <code>{{node.latestVersion}}</code>{{/if}}
    </div>
    <div class="install-cmd-box">
      <code id="node-update-cmd">{{node.updateCommand}}</code>
      <button type="button" class="btn btn-secondary btn-copy" data-copy="#node-update-cmd">کپی</button>
    </div>
    <p style="margin:0; font-size:0.85rem; color:var(--text-muted);">روی سرور همین نود با root اجرا کنید. <code>.env</code> حفظ می‌شود.</p>
  </div>
{{/if}}

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">وضعیت HTTP</span>
      <span class="stat-value" style="font-size:1.1rem;"><span class="status-pill status-{{node.statusClass}}">{{node.statusLabel}}</span></span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">صف / Rabbit</span>
      <span class="stat-value" style="font-size:1.1rem;"><span class="status-pill status-{{node.rabbitStatusClass}}">{{node.rabbitStatusLabel}}</span></span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">آدرس</span>
      <span class="stat-value" style="font-size:1rem;"><code>{{node.host}}:{{node.port}}</code></span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">نسخه</span>
      <span class="stat-value" style="font-size:1rem;">
        {{#if node.localVersion}}<code>v{{node.localVersion}}</code>{{else}}{{#if node.versionUnreachable}}در دسترس نیست{{else}}—{{/if}}{{/if}}
      </span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">آخرین بازدید</span>
      <span class="stat-value" style="font-size:1rem;">{{node.lastSeenLabel}}</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">نام صف</span>
      <span class="stat-value" style="font-size:0.9rem;"><code>{{node.queueName}}</code></span>
    </div>
  </div>
</div>

{{#if node.rabbitLastError}}
  <div class="alert alert-error" style="margin-top:1rem;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>خطای صف Rabbit: {{node.rabbitLastError}}</span>
  </div>
{{/if}}
{{#if node.lastError}}
  <div class="alert alert-error" style="margin-top:0.75rem;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>آخرین خطای تایید: {{node.lastError}}</span>
  </div>
{{/if}}

<!-- کامند نصب silent -->
<div class="content-wrapper">
  <div class="section-header">
    <span>کامند نصب نود (بدون سوال)</span>
  </div>
  <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
    این کامند را روی سرور Edge با دسترسی root اجرا کنید. همه تنظیمات از Master گرفته می‌شود و هیچ سوالی پرسیده نمی‌شود.
  </p>
  <div class="install-cmd-box">
    <code id="install-cmd">{{node.installCommand}}</code>
    <button type="button" class="btn btn-secondary btn-copy" data-copy="#install-cmd">کپی</button>
  </div>

  <div class="section-header" style="margin-top:1.5rem;">
    <span>کامند آپدیت نود</span>
  </div>
  <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
    برای به‌روز کردن کد بدون نصب مجدد و بدون از دست رفتن تنظیمات.
  </p>
  <div class="install-cmd-box">
    <code id="update-cmd">{{node.updateCommand}}</code>
    <button type="button" class="btn btn-secondary btn-copy" data-copy="#update-cmd">کپی</button>
  </div>

  <div class="section-header" style="margin-top:1.5rem;">
    <span>کامند حذف کامل نود از سرور</span>
  </div>
  <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
    روی سرور Edge با root اجرا کنید: کانتینرها، volumeها و پوشه <code>/opt/syncpage-node</code> پاک می‌شوند.
    بعد از آن از بخش پایین، نود را از پنل Master هم حذف کنید.
  </p>
  <div class="install-cmd-box">
    <code id="uninstall-cmd">{{node.uninstallCommand}}</code>
    <button type="button" class="btn btn-secondary btn-copy" data-copy="#uninstall-cmd">کپی</button>
  </div>
  {{#if node.lastError}}
    <p style="color: var(--color-danger); margin-top: 0.75rem; font-size: 0.85rem;">آخرین خطا: {{node.lastError}}</p>
  {{/if}}
  <div style="margin-top: 1rem; display:flex; gap:0.5rem; flex-wrap:wrap;">
    <form method="post" action="/spadmin/nodes/{{node.id}}/regenerate-token">
      <button type="submit" class="btn btn-secondary" onclick="return confirm('توکن قبلی باطل می‌شود. ادامه؟')">
        <span>ساخت توکن نصب جدید</span>
      </button>
    </form>
  </div>
</div>

<!-- ویرایش -->
<div class="content-wrapper mt-3">
  <div class="section-header"><span>ویرایش مشخصات</span></div>
  <form method="post" action="/spadmin/nodes/{{node.id}}">
    <div class="form-group">
      <label class="form-label" for="title">عنوان</label>
      <input class="form-control" id="title" name="title" required value="{{node.title}}" />
    </div>
    <div class="form-group">
      <label class="form-label" for="host">IP / Hostname</label>
      <input class="form-control" id="host" name="host" required value="{{node.host}}" />
    </div>
    <div class="form-group">
      <label class="form-label" for="port">پورت</label>
      <input class="form-control" id="port" name="port" type="number" min="1" max="65535" value="{{node.port}}" />
    </div>
    <div class="form-group">
      <label class="form-label" for="notes">یادداشت</label>
      <textarea class="form-control" id="notes" name="notes" rows="3">{{node.notes}}</textarea>
    </div>
    <div class="form-group">
      <label class="form-label">صف RabbitMQ</label>
      <input class="form-control" value="{{node.queueName}}" readonly />
    </div>
    <div class="form-group">
      <label class="form-label">شناسه نود</label>
      <input class="form-control" value="{{node.id}}" readonly />
    </div>
    <button type="submit" class="btn btn-primary"><span>ذخیره تغییرات</span></button>
  </form>
</div>

<div class="content-wrapper mt-3">
  <div class="section-header"><span>حذف نود از پنل</span></div>
  <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
    فقط رکورد و صف را از Master پاک می‌کند. برای پاک کردن فایل‌ها از سرور Edge، اول کامند حذف کامل بالا را اجرا کنید.
  </p>
  <form method="post" action="/spadmin/nodes/{{node.id}}/delete" onsubmit="return confirm('نود برای همیشه از پنل حذف شود؟')">
    <button type="submit" class="btn" style="background: var(--color-danger-bg); color: var(--color-danger);">
      <span>حذف از پنل Master</span>
    </button>
  </form>
</div>
