<header class="page-header">
  <div class="page-header-title">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle Sidebar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1>لیدها</h1>
    </div>
    <span class="subtitle">مشاهده ورودی‌ها، فیلتر بر اساس تاریخ و نود</span>
  </div>
</header>

<div class="content-wrapper" style="margin-bottom: 2rem;">
  <form method="GET" action="/spadmin/submissions" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">
    <div class="form-group" style="flex: 1; min-width: 250px; margin-bottom: 0;">
      <label for="formId">انتخاب فرم:</label>
      <select name="formId" id="formId" class="form-control">
        <option value="">همه فرم‌ها</option>
        {{#each forms}}
          <option value="{{id}}" {{#if (eq id ../activeFormId)}}selected{{/if}}>{{title}} ({{key}})</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 0;">
      <label for="startDate">از تاریخ:</label>
      <input type="text" name="startDate" id="startDate" placeholder="1403/01/01" value="{{startDate}}" class="form-control" />
    </div>

    <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 0;">
      <label for="endDate">تا تاریخ:</label>
      <input type="text" name="endDate" id="endDate" placeholder="1403/12/29" value="{{endDate}}" class="form-control" />
    </div>

    <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 0;">
      <label for="otpFilter">احرازهویت پیامکی:</label>
      <select name="otpFilter" id="otpFilter" class="form-control">
        <option value="">همه لیدها</option>
        <option value="VERIFIED" {{#if (eq otpFilter 'VERIFIED')}}selected{{/if}}>فقط تایید شده‌ها</option>
        <option value="UNVERIFIED" {{#if (eq otpFilter 'UNVERIFIED')}}selected{{/if}}>فقط تایید نشده‌ها</option>
      </select>
    </div>

    <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 0;">
      <label for="utmFilter">منبع/کمپین:</label>
      <input type="text" name="utmFilter" id="utmFilter" placeholder="مثلاً instagram یا summer_sale" value="{{utmFilter}}" class="form-control" />
    </div>

    <div style="display: flex; gap: 0.5rem;">
      <button type="submit" class="btn btn-primary" style="height: 38px;">
        <span>فیلتر و گزارش</span>
      </button>
      <button type="submit" formaction="/spadmin/submissions/export/excel" class="btn btn-secondary" style="height: 38px; display: inline-flex; align-items: center; gap: 0.4rem; background: #059669; border-color: #059669; color: white;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>خروجی اکسل</span>
      </button>
    </div>
  </form>
</div>

<div class="content-wrapper">
  <div class="section-header">
    <span>لیست لیدهای ثبت‌شده</span>
    <span class="status-pill">{{submissions.length}} مورد</span>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>نام فرم</th>
          <th>نود مبدا</th>
          <th>وضعیت احراز هویت</th>
          <th>تاریخ ثبت (جلالی)</th>
          <th>اطلاعات ورودی (Payload)</th>
          <th>مشخصات UTM</th>
        </tr>
      </thead>
      <tbody>
        {{#each submissions}}
        <tr>
          <td style="font-weight: 600;">{{formTitle}}</td>
          <td><span class="status-pill" style="background: rgba(255,255,255,0.06); color: var(--text-main);">{{nodeTitle}}</span></td>
          <td>
            {{#if isVerified}}
              <span class="status-pill status-ok" style="font-size: 0.8rem;">تایید شده</span>
            {{else if isUnverified}}
              <span class="status-pill status-err" style="font-size: 0.8rem; background: rgba(239, 68, 68, 0.2); color: #f87171;">احراز نشده</span>
            {{else}}
              <span style="color: var(--text-muted); font-size: 0.8rem;">بدون OTP</span>
            {{/if}}
          </td>
          <td style="white-space: nowrap;">{{jalaliDate}}</td>
          <td>
            <pre style="margin: 0; padding: 0.5rem; background: rgba(0,0,0,0.2); border-radius: 4px; font-size: 0.85rem; max-width: 500px; overflow-x: auto;">{{payloadStr}}</pre>
          </td>
          <td>
            {{#if utmStr}}
              <div style="font-size: 0.8rem; display: flex; flex-direction: column; gap: 0.25rem;">
                {{#each utms}}
                  <span style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2); padding: 0.2rem 0.4rem; border-radius: 4px; color: var(--text-main); white-space: nowrap;">
                    <strong style="color: var(--accent-primary);">{{this.key}}:</strong> {{this.value}}
                  </span>
                {{/each}}
              </div>
            {{else}}
              <span style="color: var(--text-muted); font-size: 0.8rem;">ندارد</span>
            {{/if}}
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">
            هیچ لیدی در این بازه یا برای این فرم ثبت نشده است.
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
