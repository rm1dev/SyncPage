<header class="page-header">
  <div class="page-header-title">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle Sidebar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1>لیدها</h1>
    </div>
    <span class="subtitle">مشاهده ورودی‌ها، فیلتر بر اساس تاریخ و نود</span>
  </div>
</header>

<div class="content-wrapper" style="margin-bottom: 2rem;">
  <form method="GET" action="/spadmin/submissions" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">
    <div class="form-group" style="flex: 1; min-width: 250px; margin-bottom: 0;">
      <label for="formId">انتخاب فرم:</label>
      <select name="formId" id="formId" class="form-control searchable-select">
        <option value="">همه فرم‌ها</option>
        {{#each forms}}
          <option value="{{id}}" {{#if (eq id ../activeFormId)}}selected{{/if}}>{{title}} ({{key}})</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 0;">
      <label for="startDate">از تاریخ (مثلاً 1403/01/01):</label>
      <input type="text" name="startDate" id="startDate" placeholder="1403/01/01" value="{{startDate}}" class="form-control" style="background: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-color); padding: 0.6rem; border-radius: 6px; width: 100%; height: 38px;" />
    </div>

    <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 0;">
      <label for="endDate">تا تاریخ (مثلاً 1403/12/29):</label>
      <input type="text" name="endDate" id="endDate" placeholder="1403/12/29" value="{{endDate}}" class="form-control" style="background: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-color); padding: 0.6rem; border-radius: 6px; width: 100%; height: 38px;" />
    </div>

    <button type="submit" class="btn btn-primary" style="height: 38px;">
      <span>فیلتر و گزارش</span>
    </button>
  </form>
</div>

<div class="content-wrapper">
  <div class="section-header">
    <span>لیست لیدهای ثبت‌شده</span>
    <span class="status-pill">{{submissions.length}} مورد</span>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>نام فرم</th>
          <th>نود مبدا</th>
          <th>تاریخ ثبت (جلالی)</th>
          <th>اطلاعات ورودی (Payload)</th>
        </tr>
      </thead>
      <tbody>
        {{#each submissions}}
        <tr>
          <td style="font-weight: 600;">{{formTitle}}</td>
          <td><span class="status-pill" style="background: rgba(255,255,255,0.06); color: var(--text-main);">{{nodeTitle}}</span></td>
          <td style="white-space: nowrap;">{{jalaliDate}}</td>
          <td>
            <pre style="margin: 0; padding: 0.5rem; background: rgba(0,0,0,0.2); border-radius: 4px; font-size: 0.85rem; max-width: 500px; overflow-x: auto;">{{payloadStr}}</pre>
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="4" style="text-align: center; color: var(--text-muted); padding: 2rem;">
            هیچ لیدی در این بازه یا برای این فرم ثبت نشده است.
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<!-- Select2 for searchable select -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
  /* تطبیق ظاهر Select2 با تم دارک پنل */
  .select2-container--default .select2-selection--single {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    height: 38px;
  }
  .select2-container--default .select2-selection--single .select2-selection__rendered {
    color: var(--text-main);
    line-height: 36px;
    padding-right: 12px;
    padding-left: 20px;
  }
  .select2-container--default .select2-selection--single .select2-selection__arrow {
    height: 36px;
    left: 1px;
    right: auto;
  }
  .select2-dropdown {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-main);
  }
  .select2-container--default .select2-search--dropdown .select2-search__field {
    background-color: var(--bg-body);
    border: 1px solid var(--border-color);
    color: var(--text-main);
  }
  .select2-container--default .select2-results__option[aria-selected=true] {
    background-color: rgba(99, 102, 241, 0.2);
  }
  .select2-container--default .select2-results__option--highlighted[aria-selected] {
    background-color: var(--color-primary);
    color: white;
  }
</style>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
  $(document).ready(function() {
    $('.searchable-select').select2({
      placeholder: "جستجو و انتخاب فرم...",
      allowClear: true,
      dir: "rtl"
    });
  });
</script>
