<header class="page-header">
  <div class="page-header-title">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle Sidebar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1>مدیریت نودها</h1>
    </div>
    <span class="subtitle">ثبت، نصب و تایید سرورهای Edge — HTTP و صف Rabbit</span>
  </div>
  <a href="/spadmin/nodes/new" class="btn btn-primary">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    <span>افزودن نود</span>
  </a>
</header>

{{#if flash}}
  <div class="alert alert-ok">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    <span>{{flash}}</span>
  </div>
{{/if}}
{{#if error}}
  <div class="alert alert-error">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>{{error}}</span>
  </div>
{{/if}}

{{#if masterUpdate.outdated}}
  <div class="alert alert-error" style="flex-direction:column; align-items:stretch; gap:0.75rem;">
    <div>
      <strong>Master قدیمی است</strong>
      ({{masterUpdate.localVersion}} ← {{masterUpdate.latestVersion}})
    </div>
    <div class="install-cmd-box">
      <code id="master-update-nodes">{{masterUpdate.updateCommand}}</code>
      <button type="button" class="btn btn-secondary btn-copy" data-copy="#master-update-nodes">کپی</button>
    </div>
  </div>
{{/if}}

{{#if hasOutdatedNodes}}
  <div class="alert alert-error" style="flex-direction:column; align-items:stretch; gap:0.75rem;">
    <div>
      <strong>بعضی نودها نسخه قدیمی دارند</strong>
      {{#if latestVersion}}— آخرین نسخه GitHub: <code>{{latestVersion}}</code>{{/if}}
    </div>
    <div class="install-cmd-box">
      <code id="node-update-list">{{nodeUpdateCommand}}</code>
      <button type="button" class="btn btn-secondary btn-copy" data-copy="#node-update-list">کپی</button>
    </div>
    <p style="margin:0; font-size:0.85rem; color:var(--text-muted);">روی هر Edge قدیمی این کامند را با root اجرا کنید.</p>
  </div>
{{/if}}

<div class="content-wrapper">
  <div class="section-header">
    <span>نودهای Edge</span>
    <span class="status-pill">{{nodes.length}} نود</span>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>عنوان</th>
          <th>آدرس</th>
          <th>پورت</th>
          <th>نسخه</th>
          <th>وضعیت</th>
          <th>صف / Rabbit</th>
          <th>آخرین بازدید</th>
          <th class="actions">عملیات</th>
        </tr>
      </thead>
      <tbody>
        {{#each nodes}}
        <tr>
          <td style="font-weight: 600;">{{title}}</td>
          <td><code>{{host}}</code></td>
          <td><code>{{port}}</code></td>
          <td>
            {{#if localVersion}}
              <code>v{{localVersion}}</code>
              {{#if versionOutdated}}
                <span class="status-pill status-warn" style="margin-right:0.35rem;">آپدیت</span>
              {{/if}}
            {{else}}
              <span style="color:var(--text-muted);">{{#if versionUnreachable}}در دسترس نیست{{else}}—{{/if}}</span>
            {{/if}}
          </td>
          <td><span class="status-pill status-{{statusClass}}">{{statusLabel}}</span></td>
          <td>
            <span class="status-pill status-{{rabbitStatusClass}}">{{rabbitStatusLabel}}</span>
            {{#if rabbitLastError}}
              <div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem; max-width:14rem;">{{rabbitLastError}}</div>
            {{/if}}
          </td>
          <td>{{lastSeenLabel}}</td>
          <td class="actions">
            <a href="/spadmin/nodes/{{id}}" class="btn-subtle"><span>جزئیات / نصب</span></a>
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">
            هنوز نودی ثبت نشده. با «افزودن نود» شروع کنید.
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
