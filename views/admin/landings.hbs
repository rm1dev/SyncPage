<header class="page-header">
  <div class="page-header-title">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle Sidebar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1>مدیریت لندینگ‌ها</h1>
    </div>
    <span class="subtitle">مدیریت، مشاهده، همگام‌سازی و بارگذاری صفحات لندینگ</span>
  </div>
  <div style="display: flex; align-items: center; gap: 0.75rem;">
    {{#if landings.length}}
      <form method="POST" action="/spadmin/landings/sync-all" style="margin: 0;">
        <button type="submit" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 0.4rem; background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.6rem 1rem; border-radius: 6px; font-size: 0.9rem;" title="ارسال مجدد همه لندینگ‌ها به تمام نودهای متصل">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          <span>سینک همه لندینگ‌ها</span>
        </button>
      </form>
    {{/if}}
    <button type="button" class="btn btn-secondary" id="btn-open-landing-category-dialog" style="display: inline-flex; align-items: center; gap: 0.4rem; background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.6rem 1rem; border-radius: 6px; font-size: 0.9rem;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg>
      <span>ایجاد دسته بندی</span>
    </button>
    <button type="button" class="btn btn-primary" id="btn-toggle-upload">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      <span>بارگذاری لندینگ جدید</span>
    </button>
  </div>
</header>

<dialog id="landing-category-dialog" class="category-dialog">
  <form method="post" action="/spadmin/landings/categories" style="padding: 1.5rem;">
    <div class="section-header" style="margin-bottom: 1rem;">
      <span>ایجاد دسته بندی جدید</span>
      <button type="button" class="btn btn-subtle btn-sm" data-close-category-dialog>بستن</button>
    </div>
    <div class="form-group">
      <label class="form-label" for="landing-category-name">نام دسته بندی</label>
      <input class="form-control" id="landing-category-name" name="name" required autofocus placeholder="مثلاً: کمپین تابستان" />
    </div>
    <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
      <button type="button" class="btn btn-secondary" data-close-category-dialog>انصراف</button>
      <button type="submit" class="btn btn-primary">ایجاد دسته بندی</button>
    </div>
  </form>
</dialog>

<dialog id="landing-edit-category-dialog" class="category-dialog">
  <form method="post" id="landing-edit-category-form" action="" style="padding: 1.5rem;">
    <div class="section-header" style="margin-bottom: 1rem;">
      <span>ویرایش دسته بندی</span>
      <button type="button" class="btn btn-subtle btn-sm" data-close-category-dialog>بستن</button>
    </div>
    <div class="form-group">
      <label class="form-label" for="landing-edit-category-name">نام دسته بندی</label>
      <input class="form-control" id="landing-edit-category-name" name="name" required autofocus placeholder="مثلاً: کمپین تابستان" />
    </div>
    <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
      <button type="button" class="btn btn-secondary" data-close-category-dialog>انصراف</button>
      <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
    </div>
  </form>
</dialog>

<dialog id="landing-edit-dialog" class="category-dialog">
  <form method="post" id="landing-edit-form" action="" style="padding: 1.5rem;">
    <div class="section-header" style="margin-bottom: 1rem;">
      <span>ویرایش لندینگ</span>
      <button type="button" class="btn btn-subtle btn-sm" data-close-landing-edit>بستن</button>
    </div>
    <div class="form-group">
      <label class="form-label">اسلاگ لندینگ</label>
      <code id="landing-edit-slug" dir="ltr" style="display: block; padding: 0.75rem 1rem;"></code>
      <small style="display: block; margin-top: 0.5rem; color: var(--text-muted);">اسلاگ پس از ساخت لندینگ قابل تغییر نیست.</small>
    </div>
    <div class="form-group">
      <label class="form-label" for="landing-edit-category">دسته بندی</label>
      <select class="form-control" id="landing-edit-category" name="categoryId">
        <option value="">بدون دسته بندی</option>
        {{#each categories}}
          <option value="{{id}}">{{name}}</option>
        {{/each}}
      </select>
    </div>
    <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
      <button type="button" class="btn btn-secondary" data-close-landing-edit>انصراف</button>
      <button type="submit" class="btn btn-primary">ذخیره دسته بندی</button>
    </div>
  </form>
</dialog>

{{#if error}}
  <div class="alert alert-error">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>{{error}}</span>
  </div>
{{/if}}
{{#if flash}}
  <div class="alert alert-ok">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    <span>{{flash}}</span>
  </div>
{{/if}}

<!-- Stats KPI Cards -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">کل لندینگ‌ها</span>
      <span class="stat-value">{{landings.length}}</span>
    </div>
    <div class="stat-icon" style="background: rgba(99, 102, 241, 0.12); color: #818cf8;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-info">
      <span class="stat-label">رویدادهای در صف سینک</span>
      <span class="stat-value">{{#if pendingSyncCount}}{{pendingSyncCount}}{{else}}۰{{/if}}</span>
    </div>
    <div class="stat-icon" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><polyline points="23 20 23 14 17 14"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>
    </div>
  </div>
</div>

<!-- Upload Section (Stepper & Form) -->
<div id="upload-landing-section" style="{{#if previewId}}display: block;{{else}}display: none;{{/if}} margin-bottom: 2rem;">
  <div class="stepper">
    <div class="step-item active">
      <div class="step-number">۱</div>
      <div class="step-label">بارگذاری فایل ZIP</div>
    </div>
    <div class="step-item {{#if previewId}}active{{/if}}">
      <div class="step-number">۲</div>
      <div class="step-label">پیش‌نمایش زنده</div>
    </div>
    <div class="step-item {{#if previewId}}active{{/if}}">
      <div class="step-number">۳</div>
      <div class="step-label">استقرار نهایی</div>
    </div>
  </div>

  <!-- Step 1: Upload Form -->
  <div class="content-wrapper">
    <div class="section-header" style="display: flex; justify-content: space-between; align-items: center;">
      <span>۱. انتخاب و آپلود فایل ZIP لندینگ</span>
      <button type="button" class="btn btn-subtle btn-sm" id="btn-close-upload">بستن</button>
    </div>
    <form id="upload-form" method="post" action="/spadmin/landings/upload" enctype="multipart/form-data">
      <div class="form-group">
        <label class="form-label" for="slug">اسلاگ لندینگ (Slug)</label>
        <input class="form-control" id="slug" name="slug" required pattern="[a-zA-Z0-9-_]+" placeholder="مثلاً: product-launch" value="{{slug}}" />
      </div>

      <div class="form-group">
        <label class="form-label" for="categoryId">دسته بندی</label>
        <select class="form-control" id="categoryId" name="categoryId">
          <option value="">بدون دسته بندی</option>
          {{#each categories}}
            <option value="{{id}}" {{#if (eq id ../categoryId)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </div>

      <label for="zip-upload" class="upload-area">
        <div class="upload-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        </div>
        <p>فایل ZIP حاوی <code>index.html</code> را کشیده و اینجا رها کنید یا کلیک کنید</p>
        <span class="sub-text">حداکثر حجم قابل قبول: ۱۰۰ مگابایت</span>
        <input type="file" id="zip-upload" name="file" accept=".zip" required />
      </label>

      <div class="mt-2 text-left">
        <button type="submit" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="3"/></svg>
          <span>آپلود و پیش‌نمایش</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Step 2 & 3: Preview and Confirmation -->
  {{#if previewId}}
  <div class="content-wrapper mt-3">
    <div class="section-header">
      <span>۲. پیش‌نمایش زنده لندینگ</span>
      <span class="status-pill">Checksum: <code>{{checksum}}</code></span>
    </div>
    <div class="preview-container">
      <iframe class="preview-frame" src="{{previewUrl}}" title="پیش‌نمایش لندینگ"></iframe>
    </div>
  </div>

  <div class="content-wrapper mt-3">
    <div class="section-header">
      <span>۳. تایید و استقرار نهایی در شبکه</span>
    </div>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
      با تایید این مرحله، فایل‌های لندینگ در پوشه <code>static_pages</code> جایگزین شده و رویداد همگام‌سازی برای گره‌های Edge در صف ارسال قرار می‌گیرد.
    </p>
    <form method="post" action="/spadmin/landings/confirm">
      <input type="hidden" name="previewId" value="{{previewId}}" />
      <input type="hidden" name="slug" value="{{slug}}" />
      <input type="hidden" name="categoryId" value="{{categoryId}}" />
      <div class="text-left">
        <button type="submit" class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          <span>تایید و استقرار نهایی</span>
        </button>
      </div>
    </form>
  </div>
  {{/if}}
</div>

<!-- Landings Table -->
<div class="content-wrapper">
  <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
    <div>
      <span>لیست لندینگ‌های مستقر شده</span>
      <span class="status-pill" style="background: rgba(99, 102, 241, 0.12); color: #818cf8;">{{landings.length}} لندینگ</span>
    </div>
    <form method="get" action="/spadmin/landings" style="display: flex; gap: 0.5rem; align-items: center;">
      <input class="form-control" type="search" name="q" value="{{q}}" placeholder="جستجو در اسلاگ یا دسته‌بندی" style="min-width: 250px;" />
      <button type="submit" class="btn btn-secondary">جستجو</button>
      {{#if q}}<a href="/spadmin/landings" class="btn btn-subtle">پاک کردن</a>{{/if}}
    </form>
  </div>
  <p style="color: var(--text-muted); margin: 0;">لندینگ‌ها بر اساس دسته بندی نمایش داده می‌شوند.</p>
  {{#each landingGroups}}
  <section class="content-wrapper category-card" style="margin-top: 1.5rem;">
    <div class="section-header">
      <div class="category-header">
        <div class="category-header-title">
          <span>{{name}}</span>
          <span class="status-pill">{{items.length}} لندینگ</span>
        </div>
        {{#unless (eq name 'بدون دسته بندی')}}
        <div class="category-hover-actions">
          <button type="button" class="category-action-btn btn-edit" data-edit-category-id="{{items.[0].category.id}}" data-edit-category-name="{{name}}" title="ویرایش نام دسته‌بندی">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>ویرایش</span>
          </button>
          <form method="post" action="/spadmin/landings/categories/{{items.[0].category.id}}/delete" style="display: inline; margin: 0;" onsubmit="return confirm('آیا از حذف دسته‌بندی «{{name}}» اطمینان دارید؟ با حذف، لندینگ‌های این دسته‌بندی به حالت بدون دسته‌بندی منتقل می‌شوند.');">
            <button type="submit" class="category-action-btn btn-delete" title="حذف دسته‌بندی">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
              <span>حذف</span>
            </button>
          </form>
        </div>
        {{/unless}}
      </div>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>اسلاگ لندینگ</th>
            <th>دسته‌بندی</th>
            <th>نسخه</th>
            <th>وضعیت</th>
            <th>Checksum</th>
            <th>آخرین بروزرسانی</th>
            <th class="actions">عملیات</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
        <tr>
          <td>
            <a href="{{landingUrl}}" target="_blank" rel="noopener" style="font-weight: 600; color: var(--accent-primary); text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              <span>{{slug}}</span>
            </a>
          </td>
          <td>{{#if category}}<span class="status-pill">{{category.name}}</span>{{else}}<span style="color: var(--text-muted);">-</span>{{/if}}</td>
          <td><code>v{{version}}</code></td>
          <td>
            {{#if isActive}}
              <span class="status-pill status-ok">فعال</span>
            {{else}}
              <span class="status-pill">{{status}}</span>
            {{/if}}
          </td>
          <td><code>{{checksumShort}}</code></td>
          <td style="color: var(--text-muted); font-size: 0.85rem;">{{updatedAtFa}}</td>
          <td class="actions" style="display: flex; gap: 0.5rem; justify-content: flex-end; align-items: center;">
            <button type="button" class="btn btn-subtle btn-edit-landing" data-landing-slug="{{slug}}" data-landing-category-id="{{categoryId}}" title="ویرایش مشخصات لندینگ">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              <span>ویرایش</span>
            </button>
            <a href="{{landingUrl}}" class="btn-subtle" target="_blank" rel="noopener" title="مشاهده آنلاین لندینگ">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              <span>مشاهده</span>
            </a>
            <a href="/spadmin/files?slug={{slug}}" class="btn-subtle" title="مدیریت و ویرایش فایل‌های لندینگ">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
              <span>فایل‌ها</span>
            </a>
            <a href="/spadmin/files/download/zip?slug={{slug}}" class="btn-subtle" title="دانلود پکیج ZIP لندینگ">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>دانلود ZIP</span>
            </a>
            <form method="POST" action="/spadmin/landings/sync/{{slug}}" style="margin: 0;">
              <button type="submit" class="btn btn-subtle" style="color: #6366f1;" title="ارسال مجدد این لندینگ به صف همگام‌سازی">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                <span>سینک</span>
              </button>
            </form>
            <form method="POST" action="/spadmin/landings/delete/{{slug}}" style="margin: 0;" onsubmit="return confirm('آیا از حذف کامل لندینگ {{slug}} و ارسال دستور حذف به تمام نودهای Edge مطمئن هستید؟');">
              <button type="submit" class="btn btn-subtle" style="color: #ef4444;" title="حذف کامل لندینگ">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                <span>حذف</span>
              </button>
            </form>
          </td>
        </tr>
        {{/each}}
        </tbody>
      </table>
    </div>
  </section>
  {{/each}}
  {{#unless landings.length}}
  <div class="table-responsive" style="margin-top: 1.5rem;">
    <table class="data-table">
      <tbody>
        <tr>
          <td style="text-align: center; color: var(--text-muted); padding: 3rem 1rem;">
            <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity: 0.4;"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              <div>هنوز هیچ صفحه لندینگی در سیستم ثبت نشده است.</div>
              <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('upload-landing-section').style.display='block'; document.getElementById('slug').focus();">
                <span>بارگذاری اولین لندینگ</span>
              </button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  {{/unless}}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const categoryDialog = document.getElementById('landing-category-dialog');
    const openCategoryDialog = document.getElementById('btn-open-landing-category-dialog');
    if (categoryDialog && openCategoryDialog) {
      openCategoryDialog.addEventListener('click', function() {
        categoryDialog.showModal();
      });
    }

    const editCategoryDialog = document.getElementById('landing-edit-category-dialog');
    const editCategoryForm = document.getElementById('landing-edit-category-form');
    const editCategoryName = document.getElementById('landing-edit-category-name');

    document.querySelectorAll('.btn-edit[data-edit-category-id]').forEach(function (button) {
      button.addEventListener('click', function () {
        const id = this.getAttribute('data-edit-category-id');
        const name = this.getAttribute('data-edit-category-name');
        if (editCategoryDialog && editCategoryForm && editCategoryName) {
          editCategoryForm.action = '/spadmin/landings/categories/' + encodeURIComponent(id);
          editCategoryName.value = name;
          editCategoryDialog.showModal();
        }
      });
    });

    document.querySelectorAll('[data-close-category-dialog]').forEach(function(button) {
      button.addEventListener('click', function() {
        if (categoryDialog && categoryDialog.open) categoryDialog.close();
        if (editCategoryDialog && editCategoryDialog.open) editCategoryDialog.close();
      });
    });

    [categoryDialog, editCategoryDialog].forEach(function(dialog) {
      if (dialog) {
        dialog.addEventListener('click', function(event) {
          if (event.target === dialog) dialog.close();
        });
      }
    });

    const landingEditDialog = document.getElementById('landing-edit-dialog');
    const landingEditForm = document.getElementById('landing-edit-form');
    const landingEditSlug = document.getElementById('landing-edit-slug');
    const landingEditCategory = document.getElementById('landing-edit-category');

    document.querySelectorAll('.btn-edit-landing').forEach(function(button) {
      button.addEventListener('click', function() {
        const slug = this.getAttribute('data-landing-slug') || '';
        const categoryId = this.getAttribute('data-landing-category-id') || '';
        if (landingEditDialog && landingEditForm && landingEditSlug && landingEditCategory) {
          landingEditForm.action = '/spadmin/landings/' + encodeURIComponent(slug);
          landingEditSlug.textContent = '/' + slug + '/';
          landingEditCategory.value = categoryId;
          if (landingEditCategory.tomselect) {
            landingEditCategory.tomselect.setValue(categoryId);
          }
          landingEditDialog.showModal();
          if (landingEditCategory.tomselect) {
            landingEditCategory.tomselect.focus();
          } else {
            landingEditCategory.focus();
          }
        }
      });
    });

    document.querySelectorAll('[data-close-landing-edit]').forEach(function(button) {
      button.addEventListener('click', function() {
        if (landingEditDialog && landingEditDialog.open) landingEditDialog.close();
      });
    });

    if (landingEditDialog) {
      landingEditDialog.addEventListener('click', function(event) {
        if (event.target === landingEditDialog) landingEditDialog.close();
      });
    }

    const btnToggle = document.getElementById('btn-toggle-upload');
    const btnClose = document.getElementById('btn-close-upload');
    const section = document.getElementById('upload-landing-section');
    if (btnToggle && section) {
      btnToggle.addEventListener('click', function() {
        if (section.style.display === 'none' || section.style.display === '') {
          section.style.display = 'block';
          section.scrollIntoView({ behavior: 'smooth' });
          const slugInput = document.getElementById('slug');
          if (slugInput) slugInput.focus();
        } else {
          section.style.display = 'none';
        }
      });
    }
    if (btnClose && section) {
      btnClose.addEventListener('click', function() {
        section.style.display = 'none';
      });
    }
  });
</script>

